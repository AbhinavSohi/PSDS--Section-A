def solve(N, A):
    total_sum = sum(A)

    # Each operation increases total sum by (+2 - 1) = +1
    K = -total_sum

    if K < 0:
        return -1

    if K == 0:
        return 0 if all(x == 0 for x in A) else -1

    # Positive elements must be reduced using -1 operations
    pos_sum = sum(x for x in A if x > 0)
    if pos_sum > K:
        return -1

    return K


def main():
    num_tests = int(input("Enter number of test cases (T): ").strip())

    for i in range(1, num_tests + 1):
        print(f"\n--- Test Case {i} ---")
        N = int(input("Enter N (size of array): ").strip())
        A = list(map(int, input("Enter array elements separated by space: ").strip().split()))

        result = solve(N, A)
        print("Output:", result)


if __name__ == "__main__":
    main()
