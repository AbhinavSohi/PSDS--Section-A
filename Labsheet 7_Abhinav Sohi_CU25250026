import heapq

# Input
a = list(map(int, input("Enter elements: ").split()))

# Min Heap
min_heap = a.copy()
heapq.heapify(min_heap)
print("Min Heap:", min_heap)

# Max Heap
max_heap = [-x for x in a]
heapq.heapify(max_heap)
print("Max Heap:", [-x for x in max_heap])

# Priority Queue (Min Priority Queue)
pq = []
for x in a:
    heapq.heappush(pq, x)

print("Priority Queue:", end=" ")
while pq:
    print(heapq.heappop(pq), end=" ")

# Heap Sort
print("\nHeap Sort:", sorted(a))

